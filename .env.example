# Copia questo file in ".env" e personalizza i valori.

# Porta su cui gira il server web
PORT=3000

# Segreto per firmare i token di sessione (CAMBIALO con una stringa lunga e casuale)
JWT_SECRET=metti-qui-una-stringa-lunga-e-casuale

# Cartella dove vengono salvati database e foto (default: ./data)
# DATA_DIR=/percorso/persistente/data

# Ambiente: in "production" i cookie sono inviati solo su HTTPS.
# NODE_ENV=production

# Se usi "production" ma SENZA HTTPS (es. rete interna), imposta a 1 per
# permettere il login anche via HTTP.
# DISABLE_SECURE_COOKIE=1
