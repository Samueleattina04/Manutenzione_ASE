APP_NAME="Manutenzione ASE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# In rete interna: http://IP-o-hostname. Quando pubblichi l'app all'esterno
# (es. Cloudflare Tunnel) metti qui l'indirizzo pubblico https.
APP_URL=http://localhost:8000

# --- Accesso esterno (dietro tunnel/reverse proxy con certificato valido) ---
# Attiva solo DOPO aver pubblicato l'app su un dominio https pubblico.
# FORCE_HTTPS=true            # genera tutti gli URL in https
# SESSION_SECURE_COOKIE=true  # invia i cookie solo su https

# --- Notifiche push (Web Push) ---
# Genera le chiavi con:  php artisan push:vapid  e incolla qui i valori.
# Senza queste chiavi le notifiche push restano disattivate (l'app funziona lo stesso).
# WEBPUSH_PUBLIC_KEY=
# WEBPUSH_PRIVATE_KEY=
# WEBPUSH_SUBJECT=mailto:manutenzionease@gmail.com

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT
# Fuso orario dell'applicazione (gestisce da solo ora legale/solare).
APP_TIMEZONE=Europe/Rome

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database MySQL ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=manutenzione_ase
DB_USERNAME=manutenzione
DB_PASSWORD=cambia-questa-password

# Sessioni / cache / code su database (nessun servizio esterno richiesto)
SESSION_DRIVER=database
# Durata sessione in minuti. Gli operatori (accesso libero) vedono le proprie
# richieste finché la sessione del dispositivo resta valida: 43200 = 30 giorni.
SESSION_LIFETIME=43200
CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Email ---
# "log" scrive le email nei log (storage/logs) senza inviarle davvero.
# Per inviare le notifiche ai manutentori esterni, usa "smtp".
MAIL_MAILER=log

# Esempio con GMAIL (richiede una "Password per le app" di Google, NON la
# password normale, con verifica in due passaggi attiva):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=manutenzionease@gmail.com
# MAIL_PASSWORD=la-app-password-di-16-caratteri-senza-spazi

# Esempio con SMTP aziendale (STARTTLS):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.tuazienda.it
# MAIL_PORT=587
# MAIL_USERNAME=utente
# MAIL_PASSWORD=password

MAIL_FROM_ADDRESS="manutenzionease@gmail.com"
MAIL_FROM_NAME="Manutenzione ASE"
